{
	"name": "collector",
	"version": "0.1.0",
	"private": true,
	"description": "GPON ONT telemetry collector — SNMP poll → Supabase",
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=20.9.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "node --import tsx src/index.ts",
		"build": "tsc",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.104.1",
		"net-snmp": "^3.26.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@types/node": "^20",
		"tsx": "^4.20.0",
		"typescript": "^5"
	}
}
