# Modo mock — genera 16 ONTs sintéticas sin conectar al OLT.
# Útil para desarrollo y validar el pipeline end-to-end.
MOCK_MODE=true

# OLT (ignorado en mock mode pero requerido en producción)
OLT_HOST=192.168.1.100
OLT_COMMUNITY=public
OLT_SNMP_PORT=161
OLT_SNMP_TIMEOUT_MS=5000
OLT_SNMP_RETRIES=1

# Supabase (service_role bypass-ea RLS — guardar como secret, NO publishable)
SUPABASE_URL=https://ybijrwyenlfemjjueopo.supabase.co
SUPABASE_SERVICE_KEY=

# Red a la que pertenecen las ONTs monitoreadas (UUID de la tabla networks)
NETWORK_ID=

# Cadencia y umbrales
POLL_INTERVAL_MS=60000
DEGRADATION_THRESHOLD_DB=1.5
SAMPLE_EVERY_N_POLLS=10
