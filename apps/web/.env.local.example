# Supabase — obtener en: Dashboard → Connect (o Settings → API Keys)
# Nuevo sistema de claves 2025 (reemplaza anon/service_role JWT)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<tu-clave>
SUPABASE_SECRET_KEY=sb_secret_<tu-clave>

# Mapbox — obtener en: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.<your-mapbox-public-token>

# URL pública del sitio — usada en enlaces de email (password reset, confirmación)
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis — rate limiting de signIn y requestPasswordReset
# Crear en: https://console.upstash.com/redis (free tier: 10k cmd/día)
# Si faltan, los endpoints quedan SIN protección (fail-open con warning en logs).
UPSTASH_REDIS_REST_URL=https://<region>-<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>

